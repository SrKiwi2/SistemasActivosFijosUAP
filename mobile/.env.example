# Copiar a .env.production (build de APK) o .env.development (navegador).
#
# En DESARROLLO déjalo vacío: las peticiones van a /api del propio Vite y este
# las reenvía al backend (ver vite.config.ts), evitando problemas de CORS.
# VITE_DEV_BACKEND cambia a qué backend apunta ese proxy.
VITE_API_BASE=
VITE_DEV_BACKEND=http://localhost:9696

# En PRODUCCIÓN (lo que se compila dentro del APK):
# VITE_API_BASE=https://sciaf.uap.edu.bo
